# AI provider: gemini (free testing) or openai (production)
AI_PROVIDER=gemini
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional, defaults to gemini-3.8-flash
GEMINI_MODEL=

OPENAI_API_KEY=
# Optional, defaults to gpt-5.4-mini
OPENAI_MODEL=
SUPABASE_URL=
# Supabase → Settings → API Keys → Secret key (sb_secret_...)
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_WHATSAPP_NUMBER=971542440850
NEXT_PUBLIC_META_PIXEL_ID=
# Main website, for the Terms and Privacy links
NEXT_PUBLIC_MAIN_SITE_URL=https://al-barakha.vercel.app

# Meta Conversions API (Events Manager → your pixel → Settings → Generate access token)
META_CAPI_ACCESS_TOKEN=
# Optional: code from Events Manager → Test events, while testing. Remove when live.
META_TEST_EVENT_CODE=

# Optional abuse limits (defaults shown)
# RATE_LIMIT_PER_10_MIN=20
# RATE_LIMIT_PER_DAY=80
# DAILY_MESSAGE_CAP=3000

# Optional Cloudflare Turnstile captcha on the contact form (dash.cloudflare.com → Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional ElevenLabs voice for "Voice replies" (elevenlabs.io → Profile → API keys).
# Empty = free browser voice. Free plan is for testing only (no commercial licence).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_ID_AR=

# Sales team dashboard at /admin. One "Name:password" per person, comma separated
# (passwords 8+ characters). Remove a person or change a password to log them out.
ADMIN_USERS=
# 32+ random characters, keep secret (e.g. run: openssl rand -hex 32)
ADMIN_SESSION_SECRET=
